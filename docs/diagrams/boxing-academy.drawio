        <mxCell id="jvm-title" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=21;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#1E40AF;align=left;spacing=0;" value="&lt;b&gt;Spring Boot application / JVM&lt;/b&gt;" vertex="1">
