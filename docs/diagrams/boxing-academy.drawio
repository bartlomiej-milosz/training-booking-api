          <mxGeometry height="45" width="310" x="990" y="500" as="geometry" />
        </mxCell>
        <mxCell id="client-to-host" edge="1" parent="1" source="spring" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="published-port">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="host-to-forwarder" edge="1" parent="1" source="published-port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="docker-forwarding">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="forwarder-to-postgres" edge="1" parent="1" source="docker-forwarding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="connection-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=14;align=left;verticalAlign=middle;spacing=0;fontColor=#334155;" value="Arrows show the connection path. Requests and responses use the same TCP connection." vertex="1">
          <mxGeometry height="40" width="1200" x="85" y="580" as="geometry" />
        </mxCell>
        <mxCell id="mapping-title" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=23;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=14;align=left;verticalAlign=middle;spacing=0;fontColor=#0F172A;" value="&lt;b&gt;Read the Compose mapping from left to right&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="1300" x="50" y="675" as="geometry" />
        </mxCell>
        <mxCell id="host-ip" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#EEF2FF;strokeColor=#818CF8;strokeWidth=2;spacing=14;" value="&lt;b&gt;127.0.0.1&lt;/b&gt;&lt;br&gt;HOST IP&lt;br&gt;Local access from this Mac only" vertex="1">
          <mxGeometry height="110" width="400" x="50" y="735" as="geometry" />
        </mxCell>
        <mxCell id="colon1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=32;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=14;align=center;verticalAlign=middle;spacing=0;fontColor=#64748B;" value=":" vertex="1">
          <mxGeometry height="55" width="35" x="455" y="755" as="geometry" />
        </mxCell>
        <mxCell id="host-port" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;spacing=14;" value="&lt;b&gt;5433&lt;/b&gt;&lt;br&gt;HOST PORT&lt;br&gt;The port used by Spring on the Mac" vertex="1">
          <mxGeometry height="110" width="400" x="500" y="735" as="geometry" />
        </mxCell>
        <mxCell id="colon2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=32;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=14;align=center;verticalAlign=middle;spacing=0;fontColor=#64748B;" value=":" vertex="1">
          <mxGeometry height="55" width="35" x="905" y="755" as="geometry" />
        </mxCell>
        <mxCell id="container-port" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFEDD5;strokeColor=#FB923C;strokeWidth=2;spacing=14;" value="&lt;b&gt;5432&lt;/b&gt;&lt;br&gt;CONTAINER PORT&lt;br&gt;The port PostgreSQL listens on" vertex="1">
          <mxGeometry height="110" width="400" x="950" y="735" as="geometry" />
        </mxCell>
        <mxCell id="actual-config" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=14;align=left;verticalAlign=middle;spacing=0;fontColor=#334155;" value="&lt;b&gt;Current project:&lt;/b&gt; the default mapping is 127.0.0.1:5432:5432. This drawing uses 5433 to distinguish the two ports." vertex="1">
          <mxGeometry height="45" width="1300" x="50" y="870" as="geometry" />
        </mxCell>
        <mxCell id="vm-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=14;align=left;verticalAlign=middle;spacing=0;fontColor=#64748B;" value="Conceptual view: Docker Desktop uses a Linux VM on macOS. VM internals and exact forwarding machinery are omitted." vertex="1">
          <mxGeometry height="40" width="1300" x="50" y="925" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="spring-tcp-connection-flow" name="spring-tcp-conntection">
