        </mxCell>
        <mxCell id="os-connect-label" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#475569;align=left;spacing=0;" value="macOS creates an outgoing socket" vertex="1">
          <mxGeometry height="30" width="450" x="300" y="535" as="geometry" />
        </mxCell>
        <mxCell id="socket" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=2;spacing=12;" value="&lt;b&gt;CLIENT SOURCE&lt;/b&gt;&lt;br&gt;&lt;b&gt;127.0.0.1:52184&lt;/b&gt;&lt;br&gt;Temporary port assigned by macOS" vertex="1">
          <mxGeometry height="115" width="365" x="85" y="590" as="geometry" />
        </mxCell>
        <mxCell id="driver-to-socket" edge="1" parent="1" source="jdbc" style="rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;startArrow=none;endArrow=block;endFill=1;entryX=0.5;entryY=0;exitX=0.495;exitY=0.998;exitDx=0;exitDy=0;exitPerimeter=0;" target="socket">
          <mxGeometry relative="1" x="0.3015" as="geometry" />
        </mxCell>
        <mxCell id="host-endpoint" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#EEF2FF;strokeColor=#818CF8;strokeWidth=2;spacing=12;" value="&lt;b&gt;HOST DESTINATION&lt;/b&gt;&lt;br&gt;&lt;b&gt;127.0.0.1:5433&lt;/b&gt;&lt;br&gt;Published port on the Mac" vertex="1">
          <mxGeometry height="115" width="280" x="510" y="590" as="geometry" />
        </mxCell>
        <mxCell id="docker" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;fillColor=#ECFDF5;strokeColor=#34D399;strokeWidth=2;spacing=12;" value="&lt;b&gt;DOCKER FORWARDING&lt;/b&gt;&lt;br&gt;Host 5433 → container 5432&lt;br&gt;Outside the PostgreSQL container" vertex="1">
          <mxGeometry height="115" width="250" x="850" y="590" as="geometry" />
        </mxCell>
        <mxCell id="container" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#FFF7ED;strokeColor=#F59E0B;strokeWidth=2;spacing=12;dashed=1;dashPattern=6 4;" value="" vertex="1">
          <mxGeometry height="285" width="390" x="1130" y="455" as="geometry" />
        </mxCell>
        <mxCell id="container-title" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=23;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#9A3412;align=left;spacing=0;" value="&lt;b&gt;PostgreSQL container&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="350" x="1150" y="475" as="geometry" />
        </mxCell>
        <mxCell id="listener-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#9A3412;align=center;spacing=0;" value="PostgreSQL is already listening here." vertex="1">
          <mxGeometry height="40" width="350" x="1150" y="520" as="geometry" />
        </mxCell>
        <mxCell id="postgres" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFEDD5;strokeColor=#FB923C;strokeWidth=2;spacing=12;" value="&lt;b&gt;DATABASE DESTINATION&lt;/b&gt;&lt;br&gt;&lt;b&gt;&amp;lt;container-ip&amp;gt;:5432&lt;/b&gt;&lt;br&gt;PostgreSQL server" vertex="1">
          <mxGeometry height="115" width="340" x="1155" y="590" as="geometry" />
        </mxCell>
        <mxCell id="source-to-host" edge="1" parent="1" source="socket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="host-endpoint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="host-to-docker" edge="1" parent="1" source="host-endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="docker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="docker-to-pg" edge="1" parent="1" source="docker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="socket-explanation" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=21;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#334155;align=left;spacing=0;" value="&lt;b&gt;52184 is not another published server port.&lt;/b&gt;&lt;br&gt;It identifies the client end of this outgoing TCP connection.&lt;br&gt;Spring and JDBC work in the same JVM; there is no extra network hop between them." vertex="1">
          <mxGeometry height="85" width="950" x="520" y="270" as="geometry" />
        </mxCell>
        <mxCell id="directions" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#475569;align=left;spacing=0;" value="Blue arrows: TCP traffic in both directions.&lt;br&gt;Grey arrows: calls inside the client application / operating system." vertex="1">
          <mxGeometry height="70" width="560" x="520" y="390" as="geometry" />
        </mxCell>
        <mxCell id="ports-title" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#0F172A;align=left;spacing=0;" value="&lt;b&gt;Keep the port roles separate&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="1500" x="50" y="810" as="geometry" />
        </mxCell>
        <mxCell id="source-role" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=2;spacing=12;" value="&lt;b&gt;52184 · CLIENT SOURCE PORT&lt;/b&gt;&lt;br&gt;Selected automatically by macOS.&lt;br&gt;You do not add it to Compose.&lt;br&gt;Another connection may get a different port." vertex="1">
          <mxGeometry height="125" width="470" x="50" y="870" as="geometry" />
        </mxCell>
        <mxCell id="host-role" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#EEF2FF;strokeColor=#818CF8;strokeWidth=2;spacing=12;" value="&lt;b&gt;5433 · PUBLISHED HOST PORT&lt;/b&gt;&lt;br&gt;Chosen in the Compose mapping.&lt;br&gt;Spring uses it as the destination port&lt;br&gt;when it runs directly on the Mac." vertex="1">
          <mxGeometry height="125" width="470" x="565" y="870" as="geometry" />
        </mxCell>
        <mxCell id="db-role" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFEDD5;strokeColor=#FB923C;strokeWidth=2;spacing=12;" value="&lt;b&gt;5432 · DATABASE LISTENING PORT&lt;/b&gt;&lt;br&gt;Used by PostgreSQL inside the container.&lt;br&gt;Docker forwards traffic to this port.&lt;br&gt;Docker does not reconfigure PostgreSQL." vertex="1">
          <mxGeometry height="125" width="470" x="1080" y="870" as="geometry" />
        </mxCell>
        <mxCell id="timeline-title" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=24;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#0F172A;align=left;spacing=0;" value="&lt;b&gt;What happens when a new connection is needed?&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="1500" x="50" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="tcp-label" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=2;spacing=12;" value="&lt;b&gt;1 · TCP CONNECT&lt;/b&gt;" vertex="1">
          <mxGeometry height="63" width="285" x="50" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="tcp-body" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#334155;align=left;spacing=0;" value="The driver requests a connection to 127.0.0.1:5433. macOS chooses source port 52184.&lt;br&gt;TCP is established through Docker forwarding (SYN → SYN-ACK → ACK)." vertex="1">
          <mxGeometry height="63" width="1195" x="355" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="auth-label" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=2;spacing=12;" value="&lt;b&gt;2 · DATABASE PROTOCOL&lt;/b&gt;" vertex="1">
          <mxGeometry height="63" width="285" x="50" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="auth-body" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#334155;align=left;spacing=0;" value="The driver and PostgreSQL set up their protocol and authenticate the database user&lt;br&gt;(with TLS negotiation if configured). TCP exists before SQL queries are sent." vertex="1">
          <mxGeometry height="63" width="1195" x="355" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="sql-label" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=2;spacing=12;" value="&lt;b&gt;3 · SQL AND RESULTS&lt;/b&gt;" vertex="1">
          <mxGeometry height="63" width="285" x="50" y="1255" as="geometry" />
        </mxCell>
        <mxCell id="sql-body" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#334155;align=left;spacing=0;" value="The driver sends a query, for example SELECT 1. PostgreSQL returns its result.&lt;br&gt;Both directions use the established connection; each query does not need a new source port." vertex="1">
          <mxGeometry height="63" width="1195" x="355" y="1255" as="geometry" />
        </mxCell>
        <mxCell id="pool-label" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=2;spacing=12;" value="&lt;b&gt;4 · CONNECTION REUSE&lt;/b&gt;" vertex="1">
          <mxGeometry height="63" width="285" x="50" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="pool-body" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#334155;align=left;spacing=0;" value="Spring normally uses HikariCP to keep a pool of database connections.&lt;br&gt;A later query can reuse an existing connection instead of opening a new TCP connection." vertex="1">
          <mxGeometry height="63" width="1195" x="355" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="http-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#475569;align=left;spacing=0;" value="An HTTP request to Spring (for example port 8080) is a separate connection. Spring acts as a client when it accesses PostgreSQL." vertex="1">
          <mxGeometry height="30" width="1500" x="50" y="1425" as="geometry" />
        </mxCell>
        <mxCell id="simplified-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;fontColor=#64748B;align=left;spacing=0;" value="Conceptual view: Docker Desktop VM/proxy internals are omitted. The source address/port seen by PostgreSQL may be translated." vertex="1">
          <mxGeometry height="25" width="1500" x="50" y="1470" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
