        <mxCell id="java-code" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;spacing=12;" value="&lt;b&gt;Your Java code / JPA&lt;/b&gt;&lt;br&gt;Requests a database connection" vertex="1">
