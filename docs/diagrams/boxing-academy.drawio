        <mxCell id="jdbc" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;spacing=12;" value="&lt;b&gt;PostgreSQL JDBC driver&lt;/b&gt;&lt;br&gt;The database client inside the JVM&lt;br&gt;Asks macOS to connect to 127.0.0.1:5433" vertex="1">
          <mxGeometry height="90" width="340" x="100" y="420" as="geometry" />
        </mxCell>
        <mxCell id="java-to-driver" edge="1" parent="1" source="java-code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;startArrow=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="jdbc">
